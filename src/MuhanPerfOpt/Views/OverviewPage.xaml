<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MuhanPerfOpt.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <ScrollView Padding="24" Background="{ThemeResource SystemControlPageBackgroundAltitudeBrush}">
        <StackPanel Spacing="16">
            <!-- 标题 -->
            <TextBlock Text="实时概览" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="硬件数据每秒自动刷新" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />

            <!-- CPU / GPU 两卡 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,8,0" Padding="20" Background="{ThemeResource SystemControlHighlightAltListLowBrush}" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CPU" Style="{ThemeResource SubheaderTextBlockStyle}" />
                        <TextBlock Text="{Binding CpuName}" TextWrapping="Wrap" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0:F1}%'}"
                            Style="{ThemeResource HeaderTextBlockStyle}" Foreground="{ThemeResource SystemAccentColorBrush}" />
                        <controls:ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuPercent}" />
                        <TextBlock Text="{Binding CpuTempC, StringFormat='温度 {0:F1}°C'}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="8,0,0,0" Padding="20" Background="{ThemeResource SystemControlHighlightAltListLowBrush}" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="GPU" Style="{ThemeResource SubheaderTextBlockStyle}" />
                        <TextBlock Text="{Binding GpuName}" TextWrapping="Wrap" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding GpuPercent, StringFormat='{}{0:F1}%'}"
                            Style="{ThemeResource HeaderTextBlockStyle}" Foreground="{ThemeResource SystemAccentColorBrush}" />
                        <controls:ProgressBar Minimum="0" Maximum="100" Value="{Binding GpuPercent}" />
                        <TextBlock Text="{Binding GpuTempC, StringFormat='温度 {0:F1}°C'}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RAM / 电池 / 系统 三卡 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,8,0" Padding="20" Background="{ThemeResource SystemControlHighlightAltListLowBrush}" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="物理内存" Style="{ThemeResource SubheaderTextBlockStyle}" />
                        <TextBlock Text="{Binding RamTotalGb, StringFormat='{} {0} GB'}" Style="{ThemeResource HeaderTextBlockStyle}" />
                        <controls:ProgressBar Minimum="0" Maximum="100" Value="{Binding RamPercent}" />
                        <TextBlock Text="{Binding RamPercent, StringFormat='占用 {0:F1}%'}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="4,0" Padding="20" Background="{ThemeResource SystemControlHighlightAltListLowBrush}" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="电池" Style="{ThemeResource SubheaderTextBlockStyle}" />
                        <TextBlock Text="{Binding BatteryPercent, StringFormat='{}{0}%'}" Style="{ThemeResource HeaderTextBlockStyle}" />
                        <TextBlock Text="{Binding BatteryPowerW, StringFormat='功率 {0:F1} W'}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Margin="8,0,0,0" Padding="20" Background="{ThemeResource SystemControlHighlightAltListLowBrush}" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="系统运行" Style="{ThemeResource SubheaderTextBlockStyle}" />
                        <TextBlock Text="{Binding Uptime}" Style="{ThemeResource HeaderTextBlockStyle}" />
                        <TextBlock Text="已开机" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollView>
</Page>
