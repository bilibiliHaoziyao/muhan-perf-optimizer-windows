<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MuhanPerfOpt.Views.ScreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <ScrollView Padding="24" Background="{ThemeResource SystemControlBackgroundAltitudeHighBrightAcrylicWindowBrush}">
        <StackPanel Spacing="16">
            <TextBlock Text="屏幕" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="显示器分辨率与刷新率信息" Foreground="{ThemeResource SystemColorGrayTextColor}" />

            <controls:UniformGrid Columns="3" Spacing="16">
                <controls:Card Padding="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="分辨率" Style="{ThemeResource SubheaderTextBlockStyle}" />
                        <TextBlock Text="{Binding Resolution}"
                            Style="{ThemeResource HeaderTextBlockStyle}"
                            Foreground="{ThemeResource SystemColorHighlightColor}" />
                    </StackPanel>
                </controls:Card>

                <controls:Card Padding="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="刷新率" Style="{ThemeResource SubheaderTextBlockStyle}" />
                        <TextBlock Text="{Binding RefreshRate, StringFormat='{}{0:F0} Hz'}"
                            Style="{ThemeResource HeaderTextBlockStyle}" />
                    </StackPanel>
                </controls:Card>

                <controls:Card Padding="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="显示器数量" Style="{ThemeResource SubheaderTextBlockStyle}" />
                        <TextBlock Text="{Binding Monitors}"
                            Style="{ThemeResource HeaderTextBlockStyle}" />
                    </StackPanel>
                </controls:Card>
            </controls:UniformGrid>

            <controls:Card Padding="24">
                <StackPanel Spacing="10">
                    <TextBlock Text="提示" Style="{ThemeResource SubheaderTextBlockStyle}" />
                    <TextBlock Text="如需调整分辨率或刷新率，请右键桌面 → 显示设置。高刷新率可提升游戏流畅度。"
                        TextWrapping="Wrap" Foreground="{ThemeResource SystemColorGrayTextColor}" />
                </StackPanel>
            </controls:Card>
        </StackPanel>
    </ScrollView>
</Page>
