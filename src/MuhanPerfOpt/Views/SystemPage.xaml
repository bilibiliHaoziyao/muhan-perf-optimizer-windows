<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MuhanPerfOpt.Views.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollView Padding="24" Background="{ThemeResource SystemControlPageBackgroundAltitudeBrush}">
        <StackPanel Spacing="16">
            <TextBlock Text="系统信息" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="操作系统与运行环境详情" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />

            <toolkit:Card Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Text="操作系统" Style="{ThemeResource SubheaderTextBlockStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="版本" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding OsCaption}" TextWrapping="Wrap" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="架构" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding ArchitectureText}" />
                    </Grid>

                    <TextBlock Text="设备" Style="{ThemeResource SubheaderTextBlockStyle}" Margin="0,12,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="计算机名" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding MachineName}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="当前用户" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding UserName}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="逻辑处理器" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding ProcessorCount}" />
                    </Grid>

                    <TextBlock Text="运行时" Style="{ThemeResource SubheaderTextBlockStyle}" Margin="0,12,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text=".NET 版本" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Framework}" />
                    </Grid>
                </StackPanel>
            </toolkit:Card>
        </StackPanel>
    </ScrollView>
</Page>
