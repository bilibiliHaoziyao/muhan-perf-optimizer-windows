<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MuhanPerfOpt.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollView Padding="24" Background="{ThemeResource SystemControlPageBackgroundAltitudeBrush}">
        <StackPanel Spacing="16">
            <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />

            <toolkit:Card Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="系统" Style="{ThemeResource SubheaderTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel>
                            <TextBlock Text="开机自启" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ToggleSwitch IsOn="{Binding AutoStart}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="后台自动清理" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ToggleSwitch IsOn="{Binding AutoClean}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="清理时显示通知" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ToggleSwitch IsOn="{Binding ToastOnClean}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="保存设置" Command="{Binding SaveCommand}" HorizontalAlignment="Left"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </toolkit:Card>

            <toolkit:Card Padding="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于" Style="{ThemeResource SubheaderTextBlockStyle}" />
                    <TextBlock Text="慕寒性能优化 - Windows 桌面版 v74.1" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                    <TextBlock Text="基于 WinUI 3 + Fluent Design / LibreHardwareMonitor" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                    <HyperlinkButton Content="GitHub 仓库" NavigateUri="https://github.com/bilibiliHaoziyao/muhan-perf-optimizer-windows" />
                </StackPanel>
            </toolkit:Card>
        </StackPanel>
    </ScrollView>
</Page>
