<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MuhanPerfOpt.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"

    <ScrollView Padding="24" Background="{ThemeResource SystemControlPageBackgroundAltitudeBrush}">
        <StackPanel Spacing="16">
            <TextBlock Text="存储与内存" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="物理内存与磁盘分区使用情况" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />

            <!-- 物理内存 -->
            <Border Padding="24" Background="{ThemeResource SystemControlHighlightAltListLowBrush}" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="物理内存 (RAM)" Style="{ThemeResource SubheaderTextBlockStyle}" />
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="已用" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding RamUsedGb, StringFormat='{} {} GB'}"
                                Style="{ThemeResource HeaderTextBlockStyle}" Foreground="{ThemeResource SystemAccentColorBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="总计" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding RamTotalGb, StringFormat='{} {} GB'}"
                                Style="{ThemeResource HeaderTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="占用率" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding RamPercent, StringFormat='{}{0:F1}%'}"
                                Style="{ThemeResource HeaderTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                    <controls:ProgressBar Minimum="0" Maximum="100" Value="{Binding RamPercent}" />
                </StackPanel>
            </Border>

            <!-- 磁盘分区列表 -->
            <Border Padding="24" Background="{ThemeResource SystemControlHighlightAltListLowBrush}" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="磁盘分区" Style="{ThemeResource SubheaderTextBlockStyle}" />
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 盘符 + 卷标 -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Label}" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <!-- 使用量 -->
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{Binding StringFormat='{} {} / {} {} GB'}"
                                               Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                                    <!-- 进度条 -->
                                    <controls:ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                        Minimum="0" Maximum="{Binding TotalGb}" Value="{Binding UsedGb}"
                                        Margin="0,6,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollView>
</Page>
