<Page x:Class="MuhanPerfOpt.Views.StoragePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:vm="clr-namespace:MuhanPerfOpt.ViewModels"
      Title="Storage"
      Background="{DynamicResource BackgroundBrush}">
    <Page.DataContext>
        <vm:StorageViewModel/>
    </Page.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Storage" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,24"/>
            
            <hc:Card Margin="8" Padding="16">
                <ItemsControl ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12" Margin="0,4">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0" Value="{Binding UsedPercent}" Maximum="100" Height="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UsageText}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </hc:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
