<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MuhanPerfOpt.Views.SocPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"

    <ScrollView Padding="24" Background="{ThemeResource SystemControlPageBackgroundAltitudeBrush}">
        <StackPanel Spacing="16">
            <TextBlock Text="SOC 详细" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="CPU / GPU 核心与实时负载" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />

            <!-- CPU 大卡 -->
            <Border Padding="24" Background="{ThemeResource SystemControlHighlightAltListLowBrush}" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="CPU" Style="{ThemeResource SubheaderTextBlockStyle}" />
                    <TextBlock Text="{Binding CpuName}" TextWrapping="Wrap" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />

                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="总负载" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0:F1}%'}"
                                Style="{ThemeResource HeaderTextBlockStyle}" Foreground="{ThemeResource SystemAccentColorBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="温度" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding CpuTempC, StringFormat='{}{0:F1} °C'}"
                                Style="{ThemeResource HeaderTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="核心数" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding CoreUsages.Length, StringFormat='{} {}'}"
                                Style="{ThemeResource HeaderTextBlockStyle}" />
                        </StackPanel>
                    </Grid>

                    <controls:ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuPercent}" />

                    <!-- 每核利用率（ListBox 横向滚动） -->
                    <TextBlock Text="核心负载" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <ListBox ItemsSource="{Binding CoreUsages}"
                             SelectionMode="None"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="48" Spacing="4">
                                    <TextBlock Text="{Binding StringFormat='{}{0:F0}%'}"
                                        TextAlignment="Center" FontSize="11" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />
                                    <controls:ProgressBar Minimum="0" Maximum="100" Value="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- GPU 大卡 -->
            <Border Padding="24" Background="{ThemeResource SystemControlHighlightAltListLowBrush}" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="GPU" Style="{ThemeResource SubheaderTextBlockStyle}" />
                    <TextBlock Text="{Binding GpuName}" TextWrapping="Wrap" Foreground="{ThemeResource SystemTextFillColorSecondaryBrush}" />

                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="负载" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding GpuPercent, StringFormat='{}{0:F1}%'}"
                                Style="{ThemeResource HeaderTextBlockStyle}" Foreground="{ThemeResource SystemAccentColorBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="温度" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding GpuTempC, StringFormat='{}{0:F1} °C'}"
                                Style="{ThemeResource HeaderTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="频率" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding GpuFreqMhz, StringFormat='{}{0:F0} MHz'}"
                                Style="{ThemeResource HeaderTextBlockStyle}" />
                        </StackPanel>
                    </Grid>

                    <controls:ProgressBar Minimum="0" Maximum="100" Value="{Binding GpuPercent}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollView>
</Page>
