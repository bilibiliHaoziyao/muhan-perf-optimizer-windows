<Page x:Class="MuhanPerfOpt.Views.OptimizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:vm="clr-namespace:MuhanPerfOpt.ViewModels"
      Title="Memory"
      Background="{DynamicResource BackgroundBrush}">
    <Page.DataContext>
        <vm:OptimizeViewModel/>
    </Page.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Memory Optimizer" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,24"/>
            
            <hc:Card Margin="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Current Status" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Used" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Value="{Binding MemoryPercent}" Maximum="100" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding MemoryText}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Available" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding MemoryAvailable}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>
                </StackPanel>
            </hc:Card>

            <hc:Card Margin="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Actions" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2">
                        <Button Content="Optimize All Memory" Style="{StaticResource ButtonPrimaryStyle}" Click="Optimize_Click" Margin="4"/>
                        <Button Content="Optimize Selected Process" Style="{StaticResource ButtonDefaultStyle}" Click="OptimizeSelected_Click" Margin="4"/>
                        <Button Content="Start Auto Cleanup" Style="{StaticResource ButtonDefaultStyle}" Click="StartAuto_Click" Margin="4"/>
                        <Button Content="Stop Auto Cleanup" Style="{StaticResource ButtonDefaultStyle}" Click="StopAuto_Click" Margin="4"/>
                    </UniformGrid>
                </StackPanel>
            </hc:Card>

            <hc:Card Margin="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Processes" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding Processes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Memory (MB)" Binding="{Binding MemoryMB}" Width="120"/>
                            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </hc:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
