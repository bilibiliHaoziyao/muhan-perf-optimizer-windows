<Window x:Class="MuhanPerfOpt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="MuhanPerfOpt"
        Height="720"
        Width="1120"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowDefaultStyle}">
    <DockPanel>
        <!-- Fluent Sidebar -->
        <Border DockPanel.Dock="Left" Width="220" Background="{DynamicResource RegionBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Margin="8,24">
                <TextBlock Text="MuhanPerfOpt" FontSize="20" FontWeight="Bold" 
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="8,0,0,24"/>
                
                <Button x:Name="NavHome" Content="Home" Style="{StaticResource ButtonDefaultStyle}" Tag="Home" Click="Nav_Click" Margin="4"/>
                <Button x:Name="NavSoc" Content="CPU / GPU" Style="{StaticResource ButtonDefaultStyle}" Tag="Soc" Click="Nav_Click" Margin="4"/>
                <Button x:Name="NavOpt" Content="Memory" Style="{StaticResource ButtonDefaultStyle}" Tag="Optimize" Click="Nav_Click" Margin="4"/>
                <Button x:Name="NavStor" Content="Storage" Style="{StaticResource ButtonDefaultStyle}" Tag="Storage" Click="Nav_Click" Margin="4"/>
                <Button x:Name="NavScr" Content="Display" Style="{StaticResource ButtonDefaultStyle}" Tag="Screen" Click="Nav_Click" Margin="4"/>
                <Button x:Name="NavSys" Content="System" Style="{StaticResource ButtonDefaultStyle}" Tag="System" Click="Nav_Click" Margin="4"/>
            </StackPanel>
        </Border>
        
        <!-- Content Area -->
        <Border Background="{DynamicResource BackgroundBrush}">
            <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
        </Border>
    </DockPanel>
</Window>
