<Window x:Class="MuhanPerfOpt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MuhanPerfOpt"
        Height="720"
        Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="220" Background="#FFFFFF">
            <StackPanel Margin="16,24">
                <TextBlock Text="MuhanPerfOpt" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E" Margin="8,0,0,24"/>

                <Button x:Name="NavHome" Content="Home" Tag="Home" Click="Nav_Click" Margin="4" Height="36"/>
                <Button x:Name="NavSoc" Content="CPU / GPU" Tag="Soc" Click="Nav_Click" Margin="4" Height="36"/>
                <Button x:Name="NavOpt" Content="Memory" Tag="Optimize" Click="Nav_Click" Margin="4" Height="36"/>
                <Button x:Name="NavStor" Content="Storage" Tag="Storage" Click="Nav_Click" Margin="4" Height="36"/>
                <Button x:Name="NavScr" Content="Display" Tag="Screen" Click="Nav_Click" Margin="4" Height="36"/>
                <Button x:Name="NavSys" Content="System" Tag="System" Click="Nav_Click" Margin="4" Height="36"/>
            </StackPanel>
        </Border>
        <Border Background="#F5F5F5">
            <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
        </Border>
    </DockPanel>
</Window>
